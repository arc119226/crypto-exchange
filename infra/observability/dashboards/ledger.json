          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true
        }
      ],
      "description": "Assets whose last on-chain vs ledger reconciliation did not balance."
    },
    {
      "type": "stat",
      "title": "Withdrawals pending review",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
