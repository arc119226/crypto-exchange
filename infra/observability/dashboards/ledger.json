    {
      "type": "timeseries",
      "title": "Fees vs gas",
      "description": "What the exchange earned against what it paid the chain, per asset over the dashboard's window. Nothing is converted between assets: gas is always the chain's native coin, so an ERC-20 has fee revenue and no gas line while the native coin carries the gas for every withdrawal. The exact figures are the admin revenue report; these counters are float approximations. When the gas line sits above the withdrawal-fee line for a day, WithdrawalGasExceedsFee fires.",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
