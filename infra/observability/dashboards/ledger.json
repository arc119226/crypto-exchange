      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "withdrawals_pending_review{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true
        }
      ],
      "description": "WithdrawalsPendingReview alert: > 20 for 10 min."
    },
    {
      "type": "row",
      "title": "Flows",
      "collapsed": false,
      "id": 5,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Journal entries / s by kind",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind) (rate(ledger_entries_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{kind}}",
          "range": true
        }
      ],
      "description": "hold / release / settle / credit / debit / adjustment: every balance change is one of these."
    },
