{
  "uid": "exchange-system",
  "title": "Exchange / System",
  "description": "Process CPU, memory, goroutines, file descriptors and the Postgres pool per scraped process (docs/plan-v1.0.md §15).",
  "tags": [
    "exchange"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Exchange dashboards",
      "type": "dashboards",
      "tags": [
