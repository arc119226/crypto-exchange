# .env.prod for the beta VM (deploy/compose/compose.prod.yaml,
# docs/runbooks/beta-deploy.md). scripts/gen-prod-secrets.sh copies this to
# .env.prod; every secret lives as a file under secrets/prod/ instead, so
# this file holds only what is not secret.

# Released images (the CI image job pushes all three on a v* tag)
EXCHANGE_IMAGE=ghcr.io/arc119226/crypto-exchange:v0.1.0
EXCHANGE_EDGE_IMAGE=ghcr.io/arc119226/crypto-exchange-edge:v0.1.0
EXCHANGE_BACKUP_IMAGE=ghcr.io/arc119226/crypto-exchange-backup:v0.1.0

# The public name. A real name gets an ACME certificate; "localhost" gets
# Caddy's internal CA and a browser warning, for a VM without DNS yet.
EDGE_DOMAIN=localhost

# Sepolia (docs/guides/sepolia.md); no mainnet, ever (docs/plan-v1.0.md §0).
# The RPC URL usually carries a provider key: treat this file as a secret too.
ETH_RPC_URL=
ETH_SCAN_START_BLOCK=
# m/44'/60'/1'/0/0 of the mnemonic imported into secrets/prod/keystore
HOT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
FOUNDRY_TAG=v1.8.1
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
LOG_LEVEL=info

# Backups (docs/runbooks/backup-restore.md): a store on another machine.
# --profile backup-local runs MinIO on this VM instead; then this is
# http://minio:9000 and the two key files are its root credentials.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=exchange-backups
BACKUP_S3_PREFIX=
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=14
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Set during a rotation only (docs/runbooks/key-rotation.md); the file must
# also be listed under the service's secrets in compose.prod.yaml.
# JWT_PREVIOUS_KEY_FILE=/run/secrets/jwt_previous_key
# API_KEY_MASTER_KEY_PREVIOUS_FILE=/run/secrets/api_key_master_key_previous
# WEBHOOK_SIGNING_KEY_PREVIOUS_FILE=/run/secrets/webhook_signing_key_previous
# ADMIN_TOTP_KEY_PREVIOUS_FILE=/run/secrets/admin_totp_key_previous

# Read by compose.yaml, unused here: the overlay replaces every one of these
# with a *_FILE secret. Left empty so compose does not warn.
POSTGRES_PASSWORD=
WALLET_KEYSTORE_PASSPHRASE=
WEBHOOK_SIGNING_KEY=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_API_KEY=
ADMIN_TOTP_KEY=
API_KEY_MASTER_KEY=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
CONTRACT_DEPLOYER_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Which Signer implementation holds the keys: keystore (an encrypted file plus
# a passphrase) or kms. Only keystore is buildable -- internal/chain/signer/
# kms.go is a compiled stub -- so kms is refused by config validation rather
# than accepted and left to fail at the first withdrawal.
#
# It exists because the mainnet gate needs something to read. A known mainnet
# chain id (1, 10, 137, 8453, 42161) refuses to start unless
# MAINNET_ACKNOWLEDGED=true, EXCHANGE_ENV=prod and this is not keystore -- and
# since the only value that satisfies the third is itself refused, mainnet is
# unreachable in this version by construction, not by convention.
# docs/plan-v1.0.md §4 principle 0, §22.1 gate 1.
WALLET_SIGNER_KIND=keystore
