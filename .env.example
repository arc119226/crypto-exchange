# Copy to .env with `make gen-dev-secrets`: it replaces every CHANGE_ME with a
# random value, generates secrets/jwt/ed25519.pem and a fresh BIP-39 mnemonic,
# and fills HOT_WALLET_ADDRESS. Never commit .env (gitignored).
# Variables are read by deploy/compose/compose.yaml and the Makefile.

# Image tag for ghcr.io/arc119226/crypto-exchange (compose builds it locally)
EXCHANGE_TAG=dev
LOG_LEVEL=info

# Pinned Foundry image (anvil, forge, cast); see docs/adr/0008-toolchain-pinning.md
FOUNDRY_TAG=v1.8.1

# Postgres: dev shares one password across the ex_* roles (prod: DB_PASSWORD_<ROLE>)
POSTGRES_PASSWORD=CHANGE_ME

# Secrets held by single roles (docs/plan-v1.0.md §14)
WALLET_KEYSTORE_PASSPHRASE=CHANGE_ME
# Encrypts each webhook endpoint's signing secret at rest (32 bytes hex;
# worker + admin roles). gen-dev-secrets fills it.
WEBHOOK_SIGNING_KEY=CHANGE_ME
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME
# Static key for the operator API (X-Admin-Api-Key; exchangectl admin --admin-key / EXCHANGE_ADMIN_API_KEY)
ADMIN_API_KEY=CHANGE_ME
# Seals administrators' TOTP secrets at rest (32 bytes hex; admin role).
# gen-dev-secrets fills it. Enrol with `exchange admin totp enroll --email ...`.
ADMIN_TOTP_KEY=CHANGE_ME
# Encrypts API key secrets at rest (32 bytes hex; api role). gen-dev-secrets fills it.
API_KEY_MASTER_KEY=CHANGE_ME
# Rotating a master key: set the new key above, the old one in *_PREVIOUS,
# restart, `exchange keys rewrap --domain <api-keys|webhook|totp>`, then
# remove *_PREVIOUS and restart (docs/runbooks/key-rotation.md). Every
# *_PREVIOUS also accepts a _FILE variant.
# API_KEY_MASTER_KEY_PREVIOUS=
# WEBHOOK_SIGNING_KEY_PREVIOUS=
# ADMIN_TOTP_KEY_PREVIOUS=
# A second JWT key published in the JWKS but never used to sign (the key
# just rotated out, or the one about to rotate in); a path inside the
# container, see docs/runbooks/key-rotation.md.
# JWT_PREVIOUS_KEY_FILE=/secrets/jwt/previous.pem
GRAFANA_ADMIN_PASSWORD=admin
# Backups (docs/runbooks/backup-restore.md): the S3-compatible store the
# backup sidecar ships dumps and WAL to. The compose `backup` profile runs
# MinIO with these as its root credentials; gen-dev-secrets fills the keys.
# A real deployment points the endpoint at a store on another machine.
BACKUP_S3_ENDPOINT=http://minio:9000
BACKUP_S3_BUCKET=exchange-backups
BACKUP_S3_ACCESS_KEY=CHANGE_ME
BACKUP_S3_SECRET_KEY=CHANGE_ME
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=14
# OTLP/HTTP endpoint spans are exported to; empty = tracing off. The
# observability profile runs Jaeger at http://jaeger:4318 (UI :16686), which
# gen-dev-secrets fills in. OTEL_TRACES_SAMPLER / OTEL_TRACES_SAMPLER_ARG
# are read by the SDK as usual if you want less than everything.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Key the contract deployer signs with. This value is anvil account #0 — a
# PUBLIC, well-known development key, which is why it can live in a committed
# example. On any other chain this is a real key: keep it out of this file and
# out of git (see docs/guides/sepolia.md).
CONTRACT_DEPLOYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Hot wallet = m/44'/60'/1'/0/0 of the generated mnemonic (secrets/dev-mnemonic.txt).
# gen-dev-secrets fills this in; the deployer refuses the zero address.
HOT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Which Signer implementation holds the keys: keystore (an encrypted file plus
# a passphrase) or kms. Only keystore is buildable -- internal/chain/signer/
# kms.go is a compiled stub -- so kms is refused by config validation rather
# than accepted and left to fail at the first withdrawal.
#
# It exists because the mainnet gate needs something to read. A known mainnet
# chain id (1, 10, 137, 8453, 42161) refuses to start unless
# MAINNET_ACKNOWLEDGED=true, EXCHANGE_ENV=prod and this is not keystore -- and
# since the only value that satisfies the third is itself refused, mainnet is
# unreachable in this version by construction, not by convention.
# docs/plan-v1.0.md §4 principle 0, §22.1 gate 1.
WALLET_SIGNER_KIND=keystore
