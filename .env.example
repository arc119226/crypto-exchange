# Copy to .env with `make gen-dev-secrets`: it replaces every CHANGE_ME with a
# random value, generates secrets/jwt/ed25519.pem and a fresh BIP-39 mnemonic,
# and fills HOT_WALLET_ADDRESS. Never commit .env (gitignored).
# Variables are read by deploy/compose/compose.yaml and the Makefile.

# Image tag for ghcr.io/arc119226/crypto-exchange (compose builds it locally)
EXCHANGE_TAG=dev
LOG_LEVEL=info

# Pinned Foundry image (anvil, forge, cast); see docs/adr/0008-toolchain-pinning.md
FOUNDRY_TAG=v1.8.1

# Postgres: dev shares one password across the ex_* roles (prod: DB_PASSWORD_<ROLE>)
POSTGRES_PASSWORD=CHANGE_ME

# Secrets held by single roles (docs/plan-v1.0.md §14)
WALLET_KEYSTORE_PASSPHRASE=CHANGE_ME
# Encrypts each webhook endpoint's signing secret at rest (32 bytes hex;
# worker + admin roles). gen-dev-secrets fills it.
WEBHOOK_SIGNING_KEY=CHANGE_ME
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME
# Static key for the operator API (X-Admin-Api-Key; exchangectl admin --admin-key / EXCHANGE_ADMIN_API_KEY)
ADMIN_API_KEY=CHANGE_ME
# Encrypts API key secrets at rest (32 bytes hex; api role). gen-dev-secrets fills it.
API_KEY_MASTER_KEY=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=admin

# Key the contract deployer signs with. This value is anvil account #0 — a
# PUBLIC, well-known development key, which is why it can live in a committed
# example. On any other chain this is a real key: keep it out of this file and
# out of git (see docs/runbooks/sepolia.md).
CONTRACT_DEPLOYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Hot wallet = m/44'/60'/1'/0/0 of the generated mnemonic (secrets/dev-mnemonic.txt).
# gen-dev-secrets fills this in; the deployer refuses the zero address.
HOT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
